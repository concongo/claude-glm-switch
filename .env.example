# Required for direct Z.AI launchers
ZAI_API_KEY=

# Required for LiteLLM launcher (use your proxy's Anthropic-compatible root URL)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Optional model overrides; use model names configured on the respective service
# GLM_OPUS_MODEL=glm-5.3
# GLM_SONNET_MODEL=glm-5.3
# GLM_HAIKU_MODEL=glm-5.3
# LITELLM_OPUS_MODEL=glm-5.3
# LITELLM_SONNET_MODEL=glm-5.3
# LITELLM_HAIKU_MODEL=glm-5.3
# If your LiteLLM model really supports 1M context, override Claude Code's
# 200k assumption for unknown model aliases (for example, Ollama Cloud DeepSeek V4.1 Flash):
# CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000
